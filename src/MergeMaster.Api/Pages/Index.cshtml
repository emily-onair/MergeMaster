@page
@model IndexModel
@{
    ViewData["Title"] = "MergeMaster";
}

<h1>Merge Queue</h1>
<form method="get" class="form-check form-switch" id="report-form">
    <input class="form-check-input" 
        @* asp-for="UrgentOnly" *@
        type="checkbox" 
        name="UrgentOnly" 
        value="true" 
        checked="@Model.UrgentOnly" 
        onchange="this.form.submit()" />
    <label class="form-check-label" for="UrgentOnly">Urgent Only</label>
</form>

@if (Model.Reports.Count == 0)
{
    <p>No reports yet.</p>
}
else
{
    // larger screens
    <div class="table-responsive d-none d-sm-block">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th></th>
                    <th>Branch</th>
                    <th>Commit</th>
                    <th>
                        Requested
                        <a class="btn btn-sm p-0"
                            asp-page="Index"
                            asp-route-Descending="@(!Model.Descending)"
                            asp-route-UrgentOnly="@Model.UrgentOnly"
                            title="Toggle sort direction">
                            <i class="bi @(Model.Descending ? "bi-chevron-down" : "bi-chevron-up")"></i>
                        </a>
                    </th>
                    <th>By</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model.Reports)
                {
                    <tr class="clickable @(report.Urgent ? "table-danger" : null)" data-bs-toggle="collapse" data-bs-target="#accordion_@(report.Id)">
                        <td>
                            @if (report.Urgent) {<i class="bi bi-exclamation-triangle"></i>}
                        </td>
                        <td>@report.Branch</td>
                        
                        <td>
                            @report.CommitSha.Substring(0, 5)
                        </td>
                        <td>@report.CreatedAt.ToString("dd MMM, HH:mm")</td>
                        <td>@report.AuthorName</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@report.Id">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <tr>
                        <td class="p-0" colspan="6">
                            <div id="accordion_@(report.Id)" class="collapse p-2">
                                <div class="pb-2">
                                    @foreach (var category in report.Tags.Split(","))
                                    {
                                        var cssClass = Model.CategoryClasses.TryGetValue(category, out var foundCat) 
                                            ? foundCat : "text-bg-secondary";

                                        <span class="badge @cssClass">@category</span>
                                    }
                                </div>
                                <p>@report.CommitMessage</p>
                                <dl class="row row-cols-auto font-monospace small">
                                    <dt class="col-3 text-muted">SHA</dt>
                                    <dd 
                                        class="col-9 text-break m-0" 
                                        title="click to copy" 
                                        onclick=copyToClipboard('@report.CommitSha')>@report.CommitSha</dd>
                                    <dt class="col-3 text-muted">Author</dt>
                                    <dd class="col-9 text-break m-0">@report.AuthorName &lt;@report.AuthorEmail&gt;</dd>
                                    <dt class="col-3 text-muted">Committed</dt>
                                    <dd class="col-9 text-break m-0">@report.CommitDate?.ToString("dd MMM, HH:mm")</dd>
                                </dl>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    // small screens
    <div class="d-block d-sm-none d-flex flex-column align-items-center gap-2 mt-4">
        @foreach (var report in Model.Reports)
        {
            <div class="card" style="width: 95%;">
                <div class="card-body">
                    <div class="pb-2 d-flex align-items-baseline justify-content-between">
                        <div>
                            @foreach (var category in report.Tags.Split(","))
                            {
                                var cssClass = Model.CategoryClasses.TryGetValue(category, out var foundCat) 
                                    ? foundCat : "text-bg-secondary";

                                <span class="badge @cssClass">@category</span>
                            }
                        </div>
                        <i class="card-subtitle text-muted">@report.CreatedAt.ToString("dd MMM, HH:mm")</i>
                    </div>
                    <h5 class="card-title">@report.Branch</h5>
                    <h6 
                        class="card-subtitle mb-2 text-muted" 
                        title="click to copy"
                        onclick=copyToClipboard('@report.CommitSha')>
                            @report.CommitSha.Substring(0, 5)
                    </h6>
                    <p class="card-text">@report.CommitMessage</p>
                    <dl class="row row-cols-auto font-monospace small">
                        <dt class="col-3 text-muted">Author</dt>
                        <dd class="col-9 text-break m-0">@report.AuthorName &lt;@report.AuthorEmail&gt;</dd>
                        <dt class="col-3 text-muted">Date</dt>
                        <dd class="col-9 text-break m-0">@report.CommitDate?.ToString("dd MMM, HH:mm")</dd>
                    </dl>
                </div>
            </div>
        }
    </div>


    <script>
        async function copyToClipboard(text) {
            try {
                await navigator.clipboard.writeText(text);
            } catch (err) {
                console.error("Failed to copy: ", err);
            }
        }
    </script>
}