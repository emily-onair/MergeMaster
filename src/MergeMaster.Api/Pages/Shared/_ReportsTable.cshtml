@using MergeMaster.Api.Extensions;

@model ReportsTableViewModel

<div class="table-responsive d-none d-sm-block">
    <table class="table table-hover">
        <colgroup>
            <col style="width: 2.5rem" />   @* urgent *@
            <col style="width: 13%" />      @* date *@
            <col />                         @* branch *@
            <col style="width: 10%" />      @* commit sha *@
            <col style="width: 15%" />      @* author *@
            <col style="width: 15%" />      @* tags *@
            <col style="width: 6rem" />     @* actions *@
            @* <col style="width: 15%" />      error *@
        </colgroup>
        <thead>
            <tr>
                <th>@* urgent *@</th>
                <th class="d-flex gap-1">
                    Date
                    <a class="btn btn-sm p-0"
                        href="@Model.SortUrl"
                        title="Toggle sort direction">
                        <i class="bi @(Model.IsDescending ? "bi-chevron-down" : "bi-chevron-up")"></i>
                    </a>
                </th>
                <th>Branch</th>
                <th>Commit</th>
                <th>Author</th>
                <th></th>
                <th></th>
                @* <th></th> *@
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.Reports)
            {
                <tr 
                    class="clickable" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#accordion_@(report.Id)">
                    <td>
                        <partial name="_UrgentIdentifier" model="report.Urgent" />
                    </td>
                    <td>@report.CreatedAt.ToDisplayDate()</td>
                    <td>@report.Branch</td>
                    <td>
                        @report.CommitSha.Substring(0, 5)
                    </td>
                    <td>@report.AuthorName</td>
                    <td>
                        <partial name="_TagBadges" model="report.Tags" />
                    </td>
                    <td>
                        <partial name="_ReportActions" model="new ReportActionsViewModel(report.Id, Model.IsArchive)" />
                    </td>
                    @* <td>@report.Error?.Message</td> *@
                </tr>
                <tr>
                    <td class="p-0" colspan="7">
                        <div id="accordion_@(report.Id)" class="collapse">
                            <div class="p-2">
                                <partial name="_CommitDetails" model="@report" />
                                @* <p>@report.CommitMessage</p>
                                <dl class="row row-cols-auto font-monospace small">
                                    <dt class="col-3 text-muted">SHA</dt>
                                    <dd 
                                        class="col-9 text-break m-0" 
                                        title="click to copy" 
                                        onclick=copyToClipboard('@report.CommitSha')>@report.CommitSha</dd>
                                    <dt class="col-3 text-muted">Author</dt>
                                    <dd class="col-9 text-break m-0">@report.AuthorName &lt;@report.AuthorEmail&gt;</dd>
                                    <dt class="col-3 text-muted">Committed</dt>
                                    <dd class="col-9 text-break m-0">@report.CommitDate?.ToDisplayDate()</dd>
                                </dl> *@
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>