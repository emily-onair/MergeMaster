@model FilterViewModel

<div class="card">
    <h6 class="card-header">Filter by:</h6>
    <form method="get" 
        class=" card-body d-flex flex-wrap flex-sm-nowrap gap-2 align-items-center" 
        id="report-form">

        @* keeps sort state after filtering *@
        <input type="hidden" name="IsDescending" value="@Model.FilterOptions.IsDescending">

        @* urgent switch *@
        <div class="form-check form-switch">
            <input class="form-check-input" 
                type="checkbox" 
                name="IsUrgentOnly" 
                id="IsUrgentOnly"
                value="true" 
                checked="@Model.FilterOptions.IsUrgentOnly" 
                onchange="this.form.submit()" />
            <label class="form-check-label" for="IsUrgentOnly" title="Urgent only" aria-label="filter urgent only reports">
                <partial name="_UrgentIdentifier" model="true" />
            </label>
        </div>

        @* author multiple select *@
        <partial name="_DropdownMultipleSelect" 
            model='new ReportDropdownMultipleSelectModel(Model.DropdownOptions.Authors, Model.FilterOptions.SelectedAuthors, "Author")' />

        @* tags multiple select *@
        <partial name="_DropdownMultipleSelect"
            model='new ReportDropdownMultipleSelectModel(Model.DropdownOptions.Tags, Model.FilterOptions.SelectedTags, "Tag")' />

        @* search branch/commit *@
        <input class="form-control" 
            list="datalistOptions" 
            id="search" 
            name="SearchValue"
            value="@Model.FilterOptions.SearchValue"
            placeholder="Search for a specific branch or commit">
        <datalist id="datalistOptions">
            @foreach (var branch in Model.DropdownOptions.Branches)
            {
                <option value="@branch" />
            }
            @foreach (var commit in Model.DropdownOptions.Commits)
            {
                <option value="@commit" />
            }
        </datalist>
    </form>
</div>

@* script to trigger form submit on select closure *@
<script>
    document.querySelectorAll('#report-form [data-submit-on-close]').forEach(dropdown => {
        let changed = false;
        dropdown.addEventListener('change', () => changed = true);
        dropdown.addEventListener('hidden.bs.dropdown', () => {
            if (changed) dropdown.closest('form').submit();
        });
    });
</script>