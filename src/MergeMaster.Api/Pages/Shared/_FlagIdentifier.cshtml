@model Report

@if (Model.Flagged) 
{
    <button 
        data-bs-toggle="modal"
        data-bs-target="#modal"
        data-modal-control 
        data-modal-title="Flags"
        data-modal-url='@Url.Page(null, "Flags", new { id = Model.Id })'
        aria-label="Show flags"
        class="btn btn-icon bi bi-flag-fill p-0 text-danger">
    </button>
}