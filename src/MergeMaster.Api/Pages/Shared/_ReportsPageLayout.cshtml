@model ReportsPageModel


<partial name="_Filters" 
    model="new FilterViewModel(Model.DropdownOptions, Model.FilterOptions)" />

@if (Model.Reports.Count == 0)
{
    <p>No reports yet.</p>
}
else
{
    // larger screens
    <partial name="_ReportsTable"
        model="new ReportsTableViewModel(Model.Reports, Model.FilterOptions.IsDescending, 
        Model.IsArchive, Model.SortUrl)" />

    // smaller screens
    <partial name="_ReportCards"
        model="new ReportsTableViewModel(Model.Reports, Model.FilterOptions.IsDescending, 
        Model.IsArchive, Model.SortUrl)" />

    <partial name="_PaginationControls"
        model="new PaginationControlViewModel(Model.Results, Model.PageUrl)" />


<div class="modal fade" id="modal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalTitle"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

    <script>
        async function copyToClipboard(text) {
            try {
                await navigator.clipboard.writeText(text);
            } catch (err) {
                console.error("Failed to copy: ", err);
            }
        }
    </script>
}