@model ReportsPageModel

<div style="border: solid 2px white; padding: 1rem;">
    <h6>Filter by:</h6>
    <form method="get" class="form-check form-switch" id="report-form">
        @* keeps sort state after filtering *@
        <input type="hidden" name="Descending" value="@Model.Descending">

        @* urgent switch *@
        <input class="form-check-input" 
            type="checkbox" 
            name="UrgentOnly" 
            value="true" 
            checked="@Model.UrgentOnly" 
            onchange="this.form.submit()" />
            <label class="form-check-label" for="UrgentOnly">
                <partial name="_UrgentIdentifier" model="true" />
                Urgent
            </label>
        
        @* author multiple select *@
        <div class="dropdown" data-submit-on-close>
            <button class="form-select text-start" type="button"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside">
                Author
            </button>
            <div class="dropdown-menu p-2">
                @foreach (var author in Model.Authors)
                {
                    <div class="form-check">
                        <input type="checkbox"
                            name="SelectedAuthors" value="@author" id="author_@author"
                            checked="@Model.SelectedAuthors.Contains(author)" />
                        <label class="form-check-label" for="author_@author">@author</label>
                    </div>
                }
            </div>
        </div>

        @* tags multiple select *@
        <div class="dropdown" data-submit-on-close>
            <button class="form-select text-start" type="button"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside">
                Tags
            </button>
            <div class="dropdown-menu p-2">
                @foreach (var tag in Model.Tags)
                {
                    <div class="form-check">
                        <input type="checkbox"
                            name="SelectedTags" value="@tag" id="tag_@tag"
                            checked="@Model.SelectedTags.Contains(tag)" />
                        <label class="form-check-label" for="tag_@tag">@tag</label>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

<script>
    document.querySelectorAll('#report-form [data-submit-on-close]').forEach(dropdown => {
        let changed = false;
        dropdown.addEventListener('change', () => changed = true);
        dropdown.addEventListener('hidden.bs.dropdown', () => {
            if (changed) dropdown.closest('form').submit();
        });
    });
</script>


@if (Model.Reports.Count == 0)
{
    <p>No reports yet.</p>
}
else
{
    // larger screens
    <partial name="_ReportsTable"
        model="new ReportsTableViewModel(Model.Reports, Model.Descending, Model.UrgentOnly, Model.IsArchive)" />


    <partial name="_ReportCards"
        model="new ReportsTableViewModel(Model.Reports, Model.Descending, Model.UrgentOnly, Model.IsArchive)" />

    <script>
        async function copyToClipboard(text) {
            try {
                await navigator.clipboard.writeText(text);
            } catch (err) {
                console.error("Failed to copy: ", err);
            }
        }
    </script>
}