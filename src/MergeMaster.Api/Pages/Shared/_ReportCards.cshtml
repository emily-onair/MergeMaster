@using MergeMaster.Api.Extensions;

@model ReportsTableViewModel

@* // small screens *@
<div class="d-block d-sm-none d-flex flex-column align-items-center gap-2 mt-4 mb-4">
    <a class="btn btn-sm p-0 align-self-end"
        href="@Model.SortUrl"
        title="Toggle sort direction">
        @(Model.IsDescending ? "Newest First" : "Oldest First")
        <i class="bi @(Model.IsDescending ? "bi-chevron-down" : "bi-chevron-up")"></i>
    </a>
    @foreach (var report in Model.Reports)
    {
        <div class="card" style="width: 95%;">
            <div class="card-body">
                <div class="pb-2 d-flex gap-2 align-items-baseline justify-content-between">
                    <partial name="_UrgentIdentifier" model="report.Urgent" />
                    <partial name="_TagBadges" model="report.Tags" />
                    <i class="card-subtitle text-muted ms-auto">@report.CreatedAt.ToDisplayDate()</i>
                </div>
                <h5 class="card-title">@report.Branch</h5>
                <h6 
                    class="card-subtitle mb-2 text-muted" 
                    title="click to copy"
                    onclick=copyToClipboard('@report.CommitSha')>
                        @report.CommitSha.Substring(0, 5)
                </h6>
                <h6>Commit Details</h6>
                <dl class="dl-grid font-monospace small">
                    <dt class="text-muted">Author:</dt>
                    <dd class="text-break m-0">@report.AuthorName &lt;@report.AuthorEmail&gt;</dd>
                    <dt class="text-muted">Date:</dt>
                    <dd class="text-break m-0">@report.CommitDate?.ToDisplayDate()</dd>
                    @* TODO: markdown format text *@
                    <dt class="text-muted">Message:</dt>
                    <dt class="text-break m-0">@report.CommitMessage</dt>
                </dl>
            </div>
        </div>
    }
</div>